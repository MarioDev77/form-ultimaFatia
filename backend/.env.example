# Porta da API
PORT=4000

# String de conexão do Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ultima_fatia_feedback

# Origem(ns) do frontend permitidas no CORS (separe por vírgula)
FRONTEND_URL=http://localhost:3000

# Acesso à aba administrativa
ADMIN_PASSWORD=troque-esta-senha
# Segredo do JWT: use algo longo e aleatório (ex.: openssl rand -hex 32)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Defina como 1 se a API estiver atrás de proxy/reverse proxy (Render, Railway, Nginx...)
TRUST_PROXY=0

# Defina como 1 para conexões SSL no Postgres (comum em bancos gerenciados)
DATABASE_SSL=0
